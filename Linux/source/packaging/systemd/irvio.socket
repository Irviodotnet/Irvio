[Unit]
Description=IRVIO desktop Local API socket
Requires=irvio-boot-recover.service
After=irvio-boot-recover.service

[Socket]
ListenStream=/run/irvio/control.sock
Service=irviod.service
Accept=no
SocketUser=root
SocketGroup=irvio
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
