[Unit]
Description=Resume explicitly enabled IRVIO private sharing
Wants=network-online.target irvio.socket
After=network-online.target irvio.socket
ConditionPathExists=/var/lib/irvio/profile/persistent-sharing-v1.json

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --no-block start irviod.service

[Install]
WantedBy=multi-user.target
